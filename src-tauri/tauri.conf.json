{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baton",
  "version": "0.1.6",
  "identifier": "app.baton.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Baton",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "pmrazor",
    "homepage": "https://github.com/pmrazor/Baton",
    "shortDescription": "One workspace for all your coding agents",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5OUU4Qzk0ODc4MkU1QjIKUldTeTVZS0hsSXllV1UwU3BQdDk5VFBXTXY4NnlqME5TUXplU2tvUUhqQndIak1ob2NKd3ltTFAK",
      "endpoints": [
        "https://github.com/pmrazor/Baton/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
